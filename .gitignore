# build artifacts
#
# xmake is configured with -o build/<variant>, so every variant has its own
# output tree under build/ (see build.bat). build/ itself is the only build
# directory; there are no build_* siblings any more.
build/
.xmake/
*.o
*.obj
*.exe
*.a
*.lib
*.dll
*.pdb
*.log
*.tmp

# xmake / build logs that used to be dropped in the repo root
/build*.txt
/run*.txt
/git_status.txt
/probe_*.txt

# vendored third-party (per rules: not committed; see scripts/fetch_3rdparty)
3rdparty/

# temp workspace (per rules; temp/ is for throwaway data)
temp/

# The app's own per-project data dir (sessions/patches/terminals). It lands in
# the project root, which is this repo whenever the app is pointed at itself for
# development, so it must never be committed.
.flashsight/

# generated wasm bundle + embedded-asset header (built by xmake; fs_ui_wasm
# after_build packs web/ into src/ui/ui_assets_gen.hpp - see rules/addon3.md)
web/fs_ui.js
web/fs_ui.wasm
web/fs_ui.html
src/ui/ui_assets_gen.hpp

# editor
.vscode/
.idea/

# os
Thumbs.db
.DS_Store
