# build artifacts
build/
# scratch build dirs (`xmake f -o build_check` / `-o build_whale`): a second
# config used to cross-check a toolchain or the WhaleUI switch. Build output, so
# never committed - one of them once slipped in and added ~40k cache files.
build_*/
.xmake/
*.o
*.obj
*.exe
*.a
*.lib
*.log

# vendored third-party (per rules: not committed; see scripts/fetch_3rdparty)
3rdparty/

# temp workspace (per rules; temp/ is for throwaway data)
temp/

# generated wasm bundle + embedded-asset header (built by xmake; fs_ui_wasm
# after_build packs web/ into src/ui/ui_assets_gen.hpp - see rules/addon3.md)
web/fs_ui.js
web/fs_ui.wasm
web/fs_ui.html
src/ui/ui_assets_gen.hpp

# editor
.vscode/
.idea/

# os
Thumbs.db
.DS_Store